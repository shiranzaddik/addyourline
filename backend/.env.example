# ---- Backend environment configuration ----
# Copy to .env and adjust. Never commit the real .env.

# Database. SQLite for local dev; Postgres for production.
# Example Postgres: postgresql+asyncpg://USER:PASSWORD@HOST:5432/addyourline
DATABASE_URL=sqlite+aiosqlite:///./addyourline.db

# Public base URL used to build invitation and shared-story links.
# Local dev (Vite): http://localhost:5173
# Production: https://addyourline.com
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated allowed CORS origins (the browser frontend origins).
# Production single-domain deploy: https://addyourline.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gameplay limits
MAX_NAME_LENGTH=40
MAX_TURN_LENGTH=600
ALLOWED_TURN_COUNTS=10,20,30

# Basic rate limiting for write endpoints
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
